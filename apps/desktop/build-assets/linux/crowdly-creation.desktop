#!/usr/bin/env xdg-open
[Desktop Entry]
Name=Crowdly Creation
Comment=Crowdly desktop app - read and write stories (opens in Creation mode the first time)
Exec=/opt/crowdly-creation/crowdly-creation %F
Icon=/opt/crowdly-creation/crowdly.png
Terminal=false
Type=Application
Categories=Office;TextEditor;
MimeType=text/markdown;text/x-markdown;application/x-crowdly-master;
StartupNotify=true

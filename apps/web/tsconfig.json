{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noImplicitAny": false,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@web/*": ["./src/*"],
      "@/*": ["../../src/*"]
    }
  },
  "include": ["src", "../../src/vite-env.d.ts"]
}

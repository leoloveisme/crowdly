# Connection string to your local Postgres crowdly database
# Replace user, password, host, and port as appropriate for your setup.
DATABASE_URL=postgres://lad:temirtau1@localhost:5432/crowdly

# Port for the backend HTTP server
PORT=4000

# GitHub App connector (backend/src/githubApp.js, backend/src/githubSync.js) —
# powers the "Sync with GitHub" toggle on a creative space. Leave unset to
# disable the feature entirely (no other functionality is affected).
# Register a GitHub App with Contents:read&write + Metadata:read permissions
# and push/installation/installation_repositories webhook events.
GITHUB_APP_ID=
# PEM private key downloaded from the App's settings. Paste with real
# newlines, or escape them as \n on a single line — both are accepted.
GITHUB_APP_PRIVATE_KEY=
# Shared secret configured on the App's webhook, used to verify
# X-Hub-Signature-256 on incoming POST /api/github/webhook requests.
GITHUB_WEBHOOK_SECRET=
# App slug (from its public page URL), used to build the "Connect GitHub"
# install link — https://github.com/apps/<slug>/installations/new
GITHUB_APP_SLUG=

# Base URL of the deployed frontend, used to redirect back to the right
# creative space page after a GitHub App installation completes.
FRONTEND_BASE_URL=http://localhost:8080

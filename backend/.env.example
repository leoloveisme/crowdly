# Connection string to your local Postgres crowdly database
# Replace user, password, host, and port as appropriate for your setup.
DATABASE_URL=postgres://lad:temirtau1@localhost:5432/crowdly

# Port for the backend HTTP server
PORT=4000

# GitHub App connector (backend/src/githubApp.js, backend/src/githubSync.js) —
# powers the "Sync with GitHub" toggle on a creative space. Leave unset to
# disable the feature entirely (no other functionality is affected).
# Register a GitHub App with Contents:read&write + Metadata:read permissions
# and push/installation/installation_repositories webhook events.
GITHUB_APP_ID=
# PEM private key downloaded from the App's settings. Paste with real
# newlines, or escape them as \n on a single line — both are accepted.
GITHUB_APP_PRIVATE_KEY=
# Shared secret configured on the App's webhook, used to verify
# X-Hub-Signature-256 on incoming POST /api/github/webhook requests.
GITHUB_WEBHOOK_SECRET=
# App slug (from its public page URL), used to build the "Connect GitHub"
# install link — https://github.com/apps/<slug>/installations/new
GITHUB_APP_SLUG=

# Base URL of the deployed frontend, used to redirect back to the right
# creative space page after a GitHub App installation completes.
FRONTEND_BASE_URL=http://localhost:8080

# Google Drive connector (backend/src/googleDriveApp.js, backend/src/googleDriveSync.js) —
# powers "Connect Google Drive" / "Sync with Google Drive" on a creative space.
# Leave unset to disable the feature entirely (no other functionality is affected).
# Create an OAuth 2.0 Client (Web application) in Google Cloud Console, enable
# the Drive API, and add <BACKEND_BASE_URL>/api/google-drive/oauth/callback as
# an authorized redirect URI. Uses the broad `drive` scope (not `drive.file`)
# so owners can browse and pick any existing folder (and its subfolders) —
# that scope requires Google's OAuth verification review before it works for
# anyone beyond the consent screen's test users. Full walkthrough:
# Documentation/Google_Drive_OAuth_setup.md. (The desktop app uses a separate
# "Desktop app" OAuth client of its own — see the same document.)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match the redirect URI registered in Cloud Console. Leave unset
# to default to <BACKEND_BASE_URL>/api/google-drive/oauth/callback.
GOOGLE_OAUTH_REDIRECT_URI=
# 32 random bytes, base64 (generate with `openssl rand -base64 32`) — encrypts
# stored Drive refresh tokens at rest (AES-256-GCM), and signs the OAuth
# `state` and Drive webhook channel tokens. Unlike GitHub's
# short-lived installation tokens, Drive refresh tokens are long-lived and
# must never be stored in plaintext.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Public URL of this backend itself (distinct from FRONTEND_BASE_URL above).
# Used as the base for the Google OAuth redirect URI default and for the
# Drive push-notification channel's callback address, which Google must be
# able to reach directly — localhost will not work in production.
BACKEND_BASE_URL=http://localhost:4000

# SMTP (backend/src/email.js) — sends alpha invitation/application emails and
# the /feedback form's submissions. Leave unset to disable email sending;
# affected endpoints will fail gracefully rather than crash.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@crowdly.cloud

# Feedback form (backend/src/feedback.js) — mailbox that submitted feedback
# is sent to.
FEEDBACK_TO_EMAIL=feedback@crowdly.cloud

# Self-hosted CAPTCHA service used by the /feedback form (backend/src/feedback.js).
# Leave unset to disable the feedback form's CAPTCHA (POST /api/captcha will 502).
CAPTCHA_SERVICE_URL=
CAPTCHA_API_KEY=

# Encrypts users' AI provider API keys at rest (AES-256-GCM). 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required for "AI connections"; without it, saving keys is refused.
AI_KEY_ENCRYPTION_KEY=
# Dev only: lets "OpenAI-compatible server" connections point at localhost/private
# addresses (e.g. a self-hosted model). Never enable in production (SSRF risk).
AI_ALLOW_PRIVATE_BASE_URLS=
# Optional: OpenAI API root override (a proxy, or a local mock for testing). Server setting only.
AI_OPENAI_BASE_URL=

# --- Media object storage (S3-compatible: Cloudflare R2, AWS S3, Backblaze B2, MinIO) ---
# Leave S3_BUCKET empty to keep storing uploads on this server's disk (backend/uploads).
# The bucket must be publicly readable at S3_PUBLIC_BASE_URL and allow CORS PUT from the
# site's origin (browsers upload large files straight to it). Existing files:
#   npm run migrate-media-to-storage --prefix backend -- --dry-run
S3_BUCKET=
S3_PUBLIC_BASE_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=
# Largest video file users may upload (MB). Requires object storage.
MAX_VIDEO_UPLOAD_MB=1024
